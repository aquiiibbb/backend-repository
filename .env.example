PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hotel_pms_db
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=24h
SESSION_EXPIRE=7d
# Comma separated list of frontend URLs allowed to call this API
CLIENT_URL=http://app.ahaalo.com,https://app.ahaalo.com,http://admin.ahaalo.com,https://admin.ahaalo.com
# First-start defaults (default hotel login: admin / <DEFAULT_ADMIN_PASSWORD>)
DEFAULT_TENANT_ID=default
DEFAULT_HOTEL_NAME=My Hotel
DEFAULT_ADMIN_PASSWORD=admin

# Super admin panel (/super-admin/login)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=admin123
# AI keys live ONLY here (never in the frontend)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_VISION_API_KEY=

# Old single-hotel REST API (/api/bookings, /api/rooms ...). Not used by the app and not hotel-aware -> keep off.
# ENABLE_LEGACY_API=false

# --- Email (AWS SES SMTP) ---
# SES console -> SMTP settings -> "Create SMTP credentials". support@ahaalo.com (the FROM address) must be a verified identity in SES.
AWS_REGION=us-east-1
AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_PORT=587
AWS_SES_USER=
AWS_SES_PASS=
AWS_SES_FROM_EMAIL=support@ahaalo.com
# Address of the HOTEL app (Frontend). Owners get this link in their login email.
HOTEL_APP_URL=http://app.ahaalo.com
